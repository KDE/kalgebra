></listitem>
		<listitem
><para
>الوصف: المجموع</para
></listitem>
		<listitem
><para
>الوسائط: sum(par1 : var=from..to)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;x*sum(t*t:t=0..3)</para
></listitem>
	</itemizedlist
></sect1>
