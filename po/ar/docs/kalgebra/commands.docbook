><title
>card</title
><itemizedlist>
		<listitem
><para
>الاسم: card</para
></listitem>
		<listitem
><para
>الوصف: العدد الأصلي</para
></listitem>
		<listitem
><para
>الوسائط: card(par1)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;card(vector { x, 1, 2 })</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='scalarproduct'
><title
>scalarproduct</title
><itemizedlist>
		<listitem
><para
>الاسم: scalarproduct</para
></listitem>
		<listitem
><para
>الوصف: الجداء القياسي</para
></listitem>
		<listitem
><para
>الوسائط: scalarproduct(... وسائط, ...)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;scalarproduct(vector { 0, x }, vector { x, 0 })[1]</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='selector'
><title
>selector</title
><itemizedlist>
		<listitem
><para
>الاسم: selector</para
></listitem>
		<listitem
><para
>الوصف: اختر العنصر رقم par1 من القائمة أو المتجه par2</para
></listitem>
		<listitem
><para
>الوسائط: selector(par1, par2)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;scalarproduct(vector { 0, x }, vector { x, 0 })[1]</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='union'
><title
>union</title
><itemizedlist>
		<listitem
><para
>الاسم: union</para
></listitem>
		<listitem
><para
>الوصف: يضم عدة عناصر من النوع نفسه</para
></listitem>
		<listitem
><para
>الوسائط: union(... وسائط, ...)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;union(list { 1, 2, 3 }, list { 4, 5, 6 })[rem(floor(x), 5)+3]</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='forall'
><title
>forall</title
><itemizedlist>
		<listitem
><para
>الاسم: forall</para
></listitem>
		<listitem
><para
>الوصف: لكل</para
></listitem>
		<listitem
><para
>الوسائط: forall(par1 : متغير)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;piecewise { forall(t:t@list { true, false, false }) ? 1, ? 0 }</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='exists'
><title
>exists</title
><itemizedlist>
		<listitem
><para
>الاسم: exists</para
></listitem>
		<listitem
><para
>الوصف: يوجد</para
></listitem>
		<listitem
><para
>الوسائط: exists(par1 : متغير)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;piecewise { exists(t:t@list { true, false, false }) ? 1, ? 0 }</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='map'
><title
>map</title
><itemizedlist>
		<listitem
><para
>الاسم: map</para
></listitem>
		<listitem
><para
>الوصف: يطبق دالة على كل عنصر في قائمة</para
></listitem>
		<listitem
><para
>الوسائط: map(par1, par2)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;map(x-&gt;x+x, list { 1, 2, 3, 4, 5, 6 })[rem(floor(x), 5)+3]</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='filter'
><title
>filter</title
><itemizedlist>
		<listitem
><para
>الاسم: filter</para
></listitem>
		<listitem
><para
>الوصف: يزيل كل العناصر التي لا تنطبق عليها شرط</para
></listitem>
		<listitem
><para
>الوسائط: filter(par1, par2)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;filter(u-&gt;rem(u, 2)=0, list { 2, 4, 3, 4, 8, 6 })[rem(floor(x), 5)+3]</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='transpose'
><title
>transpose</title
><itemizedlist>
		<listitem
><para
>الاسم: transpose</para
></listitem>
		<listitem
><para
>الوصف: المنقول</para
></listitem>
		<listitem
><para
>الوسائط: منقول(وس1)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;transpose(matrix { matrixrow { 1, 2, 3, 4, 5, 6 } })[rem(floor(x), 5)+3][1]</para
></listitem>
	</itemizedlist
></sect1>
</chapter>
