></listitem>
		<listitem
><para
>الوصف: الجداء</para
></listitem>
		<listitem
><para
>الوسائط: product(par1 : متغير=من..إلى)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;product(t+t:t=1..3)</para
></listitem>
	</itemizedlist
></sect1>
	<sect1 id='diff'
><title
>diff</title
><itemizedlist>
		<listitem
><para
>الاسم: diff</para
></listitem>
		<listitem
><para
>الوصف: التفاضل</para
></listitem>
		<listitem
><para
>الوسائط: diff(par1 : متغير)</para
></listitem>
		<listitem
><para
>مثال: x-&gt;(diff(x^2:x))(x)</para
></listitem>
	</itemizedlist
></sect1>
